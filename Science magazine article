<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Introduction</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background: #0f172a;
            color: white;
            line-height: 1.6;
        }

        /* Navigation */
        header {
            background: #020617;
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
        }

        nav {
            max-width: 1100px;
            margin: auto;
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            color: #38bdf8;
            font-size: 24px;
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 25px;
        }

        .nav-links a {
            color: white;
            text-decoration: none;
            transition: 0.3s;
        }

        .nav-links a:hover {
            color: #38bdf8;
        }

        /* Hero */
        .hero {
            min-height: 100vh;
            max-width: 1100px;
            margin: auto;
            padding: 120px 30px 50px;

            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 50px;
        }

        .hero-text {
            max-width: 600px;
        }

        .small-text {
            color: #38bdf8;
            font-weight: bold;
            letter-spacing: 3px;
        }

        .hero h1 {
            font-size: 60px;
            margin: 10px 0;
        }

        .hero h2 {
            color: #94a3b8;
            margin-bottom: 20px;
        }

        .hero p {
            color: #cbd5e1;
            margin-bottom: 25px;
        }

        .btn {
            display: inline-block;
            background: #38bdf8;
            color: #020617;
            padding: 12px 25px;
            border-radius: 25px;
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
        }

        .btn:hover {
            background: #0ea5e9;
            transform: translateY(-3px);
        }

        /* Profile */
        .profile-circle {
            width: 250px;
            height: 250px;
            border-radius: 50%;

            display: flex;
            justify-content: center;
            align-items: center;

            font-size: 90px;

            background: linear-gradient(
                135deg,
                #38bdf8,
                #6366f1
            );

            box-shadow: 0 0 50px rgba(56, 189, 248, 0.3);
        }

        /* Sections */
        .section {
            max-width: 900px;
            margin: auto;
            padding: 100px 30px;
            text-align: center;
        }

        .section h2 {
            font-size: 35px;
            margin-bottom: 25px;
            color: #38bdf8;
        }

        .section p {
            color: #cbd5e1;
        }

        /* Skills */
        .skills {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .skill-card {
            background: #1e293b;
            padding: 30px;
            width: 250px;
            border-radius: 15px;
            transition: 0.3s;
        }

        .skill-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }

        .skill-card h3 {
            color: #38bdf8;
            margin-bottom: 10px;
        }

        /* Contact */
        .contact button {
            margin-top: 20px;
            padding: 12px 25px;
            border: none;
            border-radius: 25px;

            background: #38bdf8;
            color: #020617;

            font-weight: bold;
            cursor: pointer;

            transition: 0.3s;
        }

        .contact button:hover {
            background: #0ea5e9;
            transform: scale(1.05);
        }

        /* Footer */
        footer {
            background: #020617;
            text-align: center;
            padding: 25px;
            color: #94a3b8;
        }

        /* Mobile */
        @media (max-width: 700px) {

            .nav-links {
                gap: 10px;
                font-size: 14px;
            }

            .hero {
                flex-direction: column-reverse;
                text-align: center;
            }

            .hero h1 {
                font-size: 45px;
            }

            .profile-circle {
                width: 180px;
                height: 180px;
                font-size: 60px;
            }
        }
    </style>
</head>

<body>

    <!-- Navigation -->
    <header>
        <nav>
            <h2 class="logo">MyPortfolio</h2>

            <ul class="nav-links">
                <li><a href="#home">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#skills">Skills</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <!-- Home -->
    <section id="home" class="hero">

        <div class="hero-text">

            <p class="small-text">HELLO, I'M</p>

            <h1>Nikolai</h1>

            <h2>Software Engineering</h2>

            <p>
                Welcome to my personal website.
                I create modern, responsive and
                user-friendly websites.
            </p>

            <a href="#about" class="btn">
                Learn More
            </a>

        </div>

        <div class="profile">
            <div class="profile-circle">
                👨‍💻
            </div>
        </div>

    </section>

    <!-- About -->
    <section id="about" class="section">

        <h2>About Me</h2>

        <p>
            Hi! My name is <strong>Nikolai</strong>.
            I'm interested in technology, programming
            and web development. I enjoy learning new
            things and building creative projects.
        </p>

    </section>

    <!-- Skills -->
    <section id="skills" class="section">

        <h2>My Skills</h2>

        <div class="skills">

            <div class="skill-card">
                <h3>HTML</h3>
                <p>
                    Building the structure of modern websites.
                </p>
            </div>

            <div class="skill-card">
                <h3>CSS</h3>
                <p>
                    Creating beautiful and responsive designs.
                </p>
            </div>

            <div class="skill-card">
                <h3>JavaScript</h3>
                <p>
                    Adding interaction and functionality.
                </p>
            </div>

        </div>

    </section>

    <!-- Contact -->
    <section id="contact" class="section contact">

        <h2>Contact Me</h2>

        <p>
            Email: nikolai@email.com
        </p>

        <button onclick="showMessage()">
            Say Hello 👋
        </button>

    </section>

    <!-- Footer -->
    <footer>
        <p>
            © 2026 Nikolai. All rights reserved.
        </p>
    </footer>

    <!-- JavaScript -->
    <script>
        function showMessage() {
            alert("Thanks for visiting my website! 👋");
        }
    </script>

</body>
</html>



